@model IEnumerable<Tasken2.Models.Property>
@{
    ViewData["Title"] = "Available Properties";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        /* Nord palette */
        body {
            background-color: #2E3440;
            color: #D8DEE9;
        }

        .search-form {
            background-color: #3B4252;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }

            .search-form .form-control {
                background-color: #4C566A;
                color: #D8DEE9;
                border: 1px solid #434C5E;
            }

                .search-form .form-control::placeholder {
                    color: #B48EAD;
                }

        .card-property {
            background-color: #3B4252;
            border: none;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            color: #ECEFF4;
        }

            .card-property .card-header {
                background-color: #434C5E;
                color: #ECEFF4;
            }

            .card-property .card-body {
                background-color: #4C566A;
            }

            .card-property .card-footer {
                background-color: #434C5E;
            }

        .btn-outline-light {
            color: #ECEFF4;
            border-color: #ECEFF4;
        }

            .btn-outline-light:hover {
                background-color: #81A1C1;
                color: #2E3440;
            }
    </style>
}

<div class="container py-4">
    <div class="search-form">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="searchArea" class="form-label">Location</label>
                <input type="text" name="searchArea" id="searchArea" class="form-control" placeholder="Enter region..." value="@Context.Request.Query["searchArea"]" />
            </div>
            <div class="col-md-3">
                <label for="searchPrice" class="form-label">Max Price</label>
                <input type="number" name="searchPrice" id="searchPrice" class="form-control" placeholder="0.00" step="0.01" value="@Context.Request.Query["searchPrice"]" />
            </div>
            <div class="col-md-3">
                <label for="searchAreaSize" class="form-label">Max Area</label>
                <input type="number" name="searchAreaSize" id="searchAreaSize" class="form-control" placeholder="0" step="0.1" value="@Context.Request.Query["searchAreaSize"]" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary mt-1">Clear</a>
            </div>
        </form>
    </div>

    <a asp-controller="PostPropertyAdd" asp-action="Index" class="btn btn-primary ms-2">Add Post</a>
	<hr />
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card card-property">
                    <div class="card-header">
                        <h5 class="mb-0">@item.Region - @item.Street</h5>
                    </div>
                    <img src="~/images/@item.Image1" class="card-img-top" alt="Property image" style="height:200px; object-fit:cover;" />
                    <div class="card-body">
                        <p class="card-text"><strong>Price:</strong> @item.Price:C</p>
                        <p class="card-text"><strong>Area:</strong> @item.Area sqm</p>
                        <p class="card-text"><strong>Rooms:</strong> @item.NumberOfRooms</p>
                        <p class="card-text"><strong>Posted:</strong> @item.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="card-footer text-end">
                        <a asp-action="Details" asp-route-id="@item.PropertyId" class="btn btn-outline-light">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}