@model Tasken2.Controllers.DTOs.ForgetPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Info"] != null)
{
    <div class="alert alert-info">@TempData["Info"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="ForgetPassword" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="NationalID" class="form-label">National ID</label>
        <input asp-for="NationalID" class="form-control" placeholder="Enter your 14-digit National ID" />
        <span asp-validation-for="NationalID" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Send Reset Link</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
