@model Tasken2.Controllers.DTOs.LoginInput
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: rgba(0, 0, 0, 0.4);
            color: white;
            font-family: Arial, sans-serif;
        }

        .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .login-form {
            background-color: rgba(0, 0, 0, 0.8);
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 400px;
        }

            .login-form h2 {
                color: #87CEEB;
                margin-bottom: 1.5rem;
                text-align: center;
            }

        .form-control {
            background-color: #333;
            color: white;
            border: 1px solid #555;
        }

            .form-control::placeholder {
                color: #aaa;
            }

            .form-control:focus {
                border-color: #87CEEB;
                box-shadow: 0 0 5px rgba(135, 206, 235, 0.5);
            }

        .form-check-input {
            background-color: #333;
            border: 1px solid #555;
        }

        .form-check-label {
            color: white;
        }

        .btn-primary {
            background-color: #444;
            border: none;
            color: white;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 8px;
        }

            .btn-primary:hover {
                background-color: #87CEEB;
            }

        .text-danger {
            color: #ff6b6b;
        }

        .no-underline {
            text-decoration: none;
        }
    </style>
}

<div class="login-container">
    <div class="login-form">
        <h2>Login</h2>
        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
            <div class="mb-3 text-end">
                <a asp-action="ForgetPassword" asp-controller="Registration" class="text-info">
                    Forgot Password?
                </a>
            </div>
            <div class="text-center mt-3">
                <a asp-controller="Registration" asp-action="Index" class="text-info no-underline">
                    Create new account?
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
