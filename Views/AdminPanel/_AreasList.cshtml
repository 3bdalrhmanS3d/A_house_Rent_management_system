@model IEnumerable<Tasken2.Models.Area>

<!-- Partial view: _AreasList.cshtml -->
<div class="areas-list-container">
    <!-- Form to add a new area -->
    <form asp-action="AddArea" asp-controller="AdminPanel" method="post" class="row g-2 mb-4">
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <input type="text" name="AreaName" class="form-control" placeholder="Area Name" required />
        </div>
        <div class="col-md-4">
            <input type="text" name="SurroundingArea" class="form-control" placeholder="Surrounding Area" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Area</button>
        </div>
    </form>

    <!-- Table of existing areas -->
    <table class="table table-admin table-striped">
        <thead>
            <tr>
                <th style="width:5%;">ID</th>
                <th>Area Name</th>
                <th>Surrounding Area</th>
                <th style="width:20%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model)
            {
                <tr>
                    <td>@area.Id</td>
                    <td>@area.AreaName</td>
                    <td>@area.SurroundingArea</td>
                    <td>
                        <button class="btn btn-sm btn-outline-light me-1"
                                data-bs-toggle="modal"
                                data-bs-target="#editAreaModal"
                                data-id="@area.Id">
                            Edit
                        </button>
                        <form asp-action="DeleteArea" asp-controller="AdminPanel" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" name="id" value="@area.Id" class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Edit Area Modal -->
    <div class="modal fade" id="editAreaModal" tabindex="-1" aria-labelledby="editAreaModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light">
                <div class="modal-header">
                    <h5 class="modal-title" id="editAreaModalLabel">Edit Area</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Content loaded via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // When edit button is clicked, load the edit form into the modal body
        $('#editAreaModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            var modal = $(this);
            modal.find('.modal-body').html('<div class="loading">Loading...</div>');
            $.get(`@Url.Action("GetArea", "AdminPanel")/${id}`, function (html) {
                modal.find('.modal-body').html(html);
            });
        });
    </script>
}
