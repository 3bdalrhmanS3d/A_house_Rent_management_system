@model IEnumerable<dynamic>
<table class="table table-admin">
    <thead>
        <tr><th>Property ID</th><th>Comments Count</th></tr>
    </thead>
    <tbody>
        @foreach(var item in Model) {
            <tr>
                <td>@item.PropertyId</td>
                <td>@item.CommentsCount</td>
            </tr>
        }
    </tbody>
</table>