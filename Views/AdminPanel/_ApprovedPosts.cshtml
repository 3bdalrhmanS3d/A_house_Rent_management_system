@model IEnumerable<Tasken2.Models.Property>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card card-admin mb-4">
                <img src="~/images/@item.Image1" class="card-img-top" alt="" style="height:200px; object-fit:cover;">
                <div class="card-body">
                    <p><strong>Area:</strong> @item.Area &nbsp; <strong>Price:</strong> @item.Price:C</p>
                    <p><strong>Address:</strong> @item.Region, @item.Street</p>
                    <a asp-action="Details" asp-controller="UserHome" asp-route-id="@item.PropertyId" class="btn btn-outline-light btn-sm">Details</a>
                    <form asp-action="DeletePost" method="post" class="d-inline">
                        <button type="submit" name="id" value="@item.PropertyId" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                    <form asp-action="PendingPost" method="post" class="d-inline">
                        <button type="submit" name="id" value="@item.PropertyId" class="btn btn-outline-warning btn-sm">Pending</button>
                    </form>

                </div>
            </div>
        </div>
    }
</div>