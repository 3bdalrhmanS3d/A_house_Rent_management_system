@model Tasken2.Controllers.DTOs.AccountViewModel
@{
    ViewData["Title"] = "My Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        /* Nord color palette for comfortable dark theme */
        body {
            background-color: #2E3440; /* dark slate gray */
            color: #ECEFF4; /* light gray */
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .account-container {
            padding: 2rem;
        }

        .account-header {
            margin-bottom: 1.5rem;
            color: #81A1C1; /* soft blue */
        }

        .btn-primary {
            background-color: #5E81AC; /* nord blue */
            border: none;
            color: #ECEFF4;
        }

            .btn-primary:hover {
                background-color: #81A1C1; /* lighter blue */
            }

        .btn-warning {
            background-color: #D08770; /* nord orange */
            border: none;
            color: #2E3440;
        }

            .btn-warning:hover {
                background-color: #EBCB8B; /* nord light orange */
            }

        .btn-secondary {
            background-color: #4C566A; /* nord gray */
            border: none;
            color: #ECEFF4;
        }

            .btn-secondary:hover {
                background-color: #434C5E; /* darker gray */
            }

        table {
            background-color: #3B4252; /* nord darker slate */
            color: #ECEFF4;
            border-radius: 8px;
            overflow: hidden;
        }

        .table th, .table td {
            vertical-align: middle;
            border-bottom: 1px solid #4C566A;
        }

        .table thead {
            background-color: #434C5E;
        }

        .table tbody tr:hover {
            background-color: #4C566A;
        }
    </style>
}

<div class="account-container">
    <h2 class="account-header text-info">Welcome, @Model.Person.FullName</h2>

    @if (TempData["message"] != null)
    {
        <div class="alert alert-info">@TempData["message"]</div>
    }

    <div class="mb-4">
        <a asp-action="EditProfile" class="btn btn-primary">Edit Profile</a>
        <a asp-action="ChangePassword" class="btn btn-primary ms-2">Change Password</a>
        <a asp-controller="Property" asp-action="Add" class="btn btn-primary ms-2">Add Property</a>
    </div>


    <h3>Active Posts</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Region</th>
                <th>Street</th>
                <th>Price</th>
                <th>Area</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in Model.ActivePosts)
            {
                <tr>
                    <td><img src="~/images/@post.Image1" alt="" width="100" /></td>
                    <td>@post.Region</td>
                    <td>@post.Street</td>
                    <td>@post.Price:C</td>
                    <td>@post.Area</td>
                    <td>
                        <a asp-action="EditProperty" asp-route-id="@post.PropertyId" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-action="DisablePost" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@post.PropertyId" />
                            <button type="submit" class="btn btn-secondary btn-sm">Disable</button>
                        </form>
                        <form asp-action="DeletePost" method="post" class="d-inline ms-1">
                            <input type="hidden" name="id" value="@post.PropertyId" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="mt-5">Inactive Posts</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Region</th>
                <th>Street</th>
                <th>Price</th>
                <th>Area</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in Model.InactivePosts)
            {
                <tr>
                    <td><img src="~/images/@post.Image1" alt="" width="100" /></td>
                    <td>@post.Region</td>
                    <td>@post.Street</td>
                    <td>@post.Price:C</td>
                    <td>@post.Area</td>
                    <td>
                        <form asp-action="ActivatePost" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@post.PropertyId" />
                            <button type="submit" class="btn btn-success btn-sm">Activate</button>
                        </form>
                        <form asp-action="DeletePost" method="post" class="d-inline ms-1">
                            <input type="hidden" name="id" value="@post.PropertyId" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}