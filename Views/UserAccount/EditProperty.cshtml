@model Tasken2.Controllers.DTOs.PropertyEditInput
@{
    ViewData["Title"] = "Edit Property";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        .property-edit-container {
            display: flex;
            justify-content: center;
            padding: 2rem;
        }

        .property-edit-form {
            background-color: rgba(0, 0, 0, 0.8);
            padding: 2rem;
            border-radius: 10px;
            width: 100%;
            max-width: 600px;
            color: white;
        }

            .property-edit-form h2 {
                color: #87CEEB;
                margin-bottom: 1.5rem;
                text-align: center;
            }

        .form-control, .form-select {
            background-color: #333;
            color: white;
            border: 1px solid #555;
        }

            .form-control:focus, .form-select:focus {
                border-color: #87CEEB;
                box-shadow: 0 0 5px rgba(135, 206, 235, 0.5);
            }

        .btn-primary {
            background-color: #444;
            border: none;
        }

            .btn-primary:hover {
                background-color: #87CEEB;
            }

        .text-danger {
            color: #ff6b6b;
        }
    </style>
}

<div class="property-edit-container">
    <div class="property-edit-form">
        <h2>Edit Property</h2>
        <form asp-action="EditProperty" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="PropertyId" />

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Area" class="form-label"></label>
                <input asp-for="Area" class="form-control" />
                <span asp-validation-for="Area" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumberOfRooms" class="form-label"></label>
                <input asp-for="NumberOfRooms" class="form-control" />
                <span asp-validation-for="NumberOfRooms" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Region" class="form-label"></label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Street" class="form-label"></label>
                <input asp-for="Street" class="form-control" />
                <span asp-validation-for="Street" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FloorNumber" class="form-label"></label>
                <input asp-for="FloorNumber" class="form-control" />
                <span asp-validation-for="FloorNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AreaId" class="form-label"></label>
                <select asp-for="AreaId" class="form-select" asp-items="ViewBag.AreaList"></select>
                <span asp-validation-for="AreaId" class="text-danger"></span>
            </div>

            <h4 class="mt-4">Update Images</h4>
            @for (int i = 0; i < 5; i++)
            {
                <div class="mb-3">
                    <label class="form-label">Image @(i + 1)</label>
                    <input asp-for="ImageFiles[i]" type="file" class="form-control" />
                </div>
            }

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}