@model Tasken2.Controllers.DTOs.ChangePasswordInput

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        .change-password-container {
            display: flex;
            justify-content: center;
            padding: 2rem;
        }

        .change-password-form {
            background-color: rgba(46, 52, 64, 0.9);
            padding: 2rem;
            border-radius: 10px;
            width: 100%;
            max-width: 400px;
            color: #ECEFF4;
        }

            .change-password-form h2 {
                color: #81A1C1;
                margin-bottom: 1.5rem;
                text-align: center;
            }

        .form-control {
            background-color: #3B4252;
            color: #ECEFF4;
            border: 1px solid #4C566A;
        }

            .form-control:focus {
                border-color: #81A1C1;
                box-shadow: 0 0 5px rgba(135, 206, 241, 0.5);
            }

        .btn-primary {
            background-color: #5E81AC;
            border: none;
            color: #ECEFF4;
        }

            .btn-primary:hover {
                background-color: #81A1C1;
            }

        .text-danger {
            color: #BF616A;
        }
    </style>
}

<div class="change-password-container">
    <div class="change-password-form">
        <h2>Change Password</h2>
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Current password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="New password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
